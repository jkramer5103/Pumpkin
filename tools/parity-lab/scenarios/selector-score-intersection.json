{
  "schema_version": 1,
  "id": "selector-score-intersection",
  "title": "Multiple score filters intersect",
  "category": "scoreboard",
  "description": "Only the marker satisfying both objective ranges receives the selected tag; each single-range control survives unselected.",
  "tags": [
    "command",
    "deterministic",
    "state-observation",
    "execution-campaign"
  ],
  "setup": [
    "tick freeze",
    "execute if entity @e[type=minecraft:marker,tag=pp,x=-32,y=48,z=-32,dx=64,dy=48,dz=64] run kill @e[type=minecraft:marker,tag=pp,x=-32,y=48,z=-32,dx=64,dy=48,dz=64]",
    "scoreboard objectives add pp_exec dummy",
    "scoreboard objectives add pp_aux dummy"
  ],
  "steps": [
    {
      "command": "summon minecraft:marker 2 64 2 {Tags:[\"pp\",\"both\"]}"
    },
    {
      "command": "summon minecraft:marker 4 64 2 {Tags:[\"pp\",\"first\"]}"
    },
    {
      "command": "summon minecraft:marker 6 64 2 {Tags:[\"pp\",\"second\"]}"
    },
    {
      "command": "scoreboard players set @e[type=minecraft:marker,tag=pp,x=-32,y=48,z=-32,dx=64,dy=48,dz=64] pp_exec 0"
    },
    {
      "command": "scoreboard players set @e[type=minecraft:marker,tag=pp,x=-32,y=48,z=-32,dx=64,dy=48,dz=64] pp_aux 0"
    },
    {
      "command": "scoreboard players set @e[type=minecraft:marker,tag=pp,x=-32,y=48,z=-32,dx=64,dy=48,dz=64,tag=both] pp_exec 1"
    },
    {
      "command": "scoreboard players set @e[type=minecraft:marker,tag=pp,x=-32,y=48,z=-32,dx=64,dy=48,dz=64,tag=both] pp_aux 2"
    },
    {
      "command": "scoreboard players set @e[type=minecraft:marker,tag=pp,x=-32,y=48,z=-32,dx=64,dy=48,dz=64,tag=first] pp_exec 1"
    },
    {
      "command": "scoreboard players set @e[type=minecraft:marker,tag=pp,x=-32,y=48,z=-32,dx=64,dy=48,dz=64,tag=second] pp_aux 2"
    },
    {
      "command": "tag @e[type=minecraft:marker,tag=pp,x=-32,y=48,z=-32,dx=64,dy=48,dz=64,scores={pp_exec=1,pp_aux=2}] add selected"
    },
    {
      "command": "execute if entity @e[type=minecraft:marker,tag=pp,x=-32,y=48,z=-32,dx=64,dy=48,dz=64,tag=both,tag=selected] if entity @e[type=minecraft:marker,tag=pp,x=-32,y=48,z=-32,dx=64,dy=48,dz=64,tag=first,tag=!selected] if entity @e[type=minecraft:marker,tag=pp,x=-32,y=48,z=-32,dx=64,dy=48,dz=64,tag=second,tag=!selected]",
      "observe": true,
      "expect_contains": "Test passed"
    }
  ],
  "cleanup": [
    "execute if entity @e[type=minecraft:marker,tag=pp,x=-32,y=48,z=-32,dx=64,dy=48,dz=64] run kill @e[type=minecraft:marker,tag=pp,x=-32,y=48,z=-32,dx=64,dy=48,dz=64]",
    "scoreboard objectives remove pp_aux",
    "scoreboard objectives remove pp_exec",
    "tick unfreeze"
  ],
  "notes": "Vanilla 26.3 reference expectations are checked live; raw responses remain in campaign artifacts. Simulation is frozen and restored in cleanup. Positive state probes fail on empty or rejected output. Current-source console validation is separate from RCON support. No client or elapsed-tick claim."
}

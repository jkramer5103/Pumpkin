{
  "schema_version": 1,
  "id": "wither-construction-arm-clearance",
  "title": "Wither construction requires air beneath both arms",
  "category": "entities",
  "description": "Run in an isolated arena with a connected creative protocol777 client. At each PARITY_BUILD_PLACE marker the driver must send a main-hand UseItemOn packet against the indicated soul block top before advancing the two ticks. Console-only execution cannot exercise vanilla skull placement. Two axes; ordinary/cave air, individual stone blockers, both soul-sand blockers and water.",
  "tags": [
    "entity",
    "wither",
    "construction"
  ],
  "setup": [
    "tick freeze",
    "gamemode creative @a",
    "op ParitySmoke",
    "difficulty easy",
    "gamerule mob_griefing false",
    "gamerule spawn_mobs false",
    "forceload add 0 0 31 31",
    "fill 0 79 0 31 79 31 minecraft:bedrock",
    "tp @a 15.5 81 19.5",
    "item replace entity @a weapon.mainhand with minecraft:wither_skeleton_skull"
  ],

    "difficulty easy",
    "gamerule mob_griefing false",
    "gamerule spawn_mobs false",
    "forceload add 0 0 15 15",
    "fill 0 79 0 15 79 15 minecraft:bedrock",
    "gamemode creative @a",
    "tp @a 8.0 86.0 8.0",
    "summon minecraft:wither 8.0 80.0 3.0 {Tags:[\"pp_boss\"],NoGravity:1b,Silent:1b,PersistenceRequired:1b,Rotation:[0.0f,0.0f]}",
    "summon minecraft:sheep 4.0 80.0 13.0 {Tags:[\"pp_left\"],NoAI:1b,NoGravity:1b,Silent:1b,PersistenceRequired:1b}",
    "summon minecraft:sheep 12.0 80.0 13.0 {Tags:[\"pp_right\"],NoAI:1b,NoGravity:1b,Silent:1b,PersistenceRequired:1b}"
  ],

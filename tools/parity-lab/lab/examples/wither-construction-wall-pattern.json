{
  "schema_version": 1,
  "category": "entities",
  "tags": [
    "entity",
    "wither",
    "construction"
  ],
  "setup": [
    "tick freeze",
    "gamemode creative @a",
    "op ParitySmoke",
    "difficulty easy",
    "gamerule mob_griefing false",
    "gamerule spawn_mobs false",
    "forceload add 0 0 31 31",
    "fill 0 79 0 31 79 31 minecraft:bedrock",
    "tp @a 15.5 81 19.5",
    "item replace entity @a weapon.mainhand with minecraft:wither_skeleton_skull"
  ],
  "cleanup": [
    "kill @e[type=!minecraft:player]",
    "fill 12 80 12 18 85 18 minecraft:air",
    "forceload remove all"
  ],
  "id": "wither-construction-wall-pattern",
  "title": "Wither construction accepts existing wall skulls",
  "description": "A connected loaded creative client places the final floor skull with a main-hand UseItemOn packet at PARITY_BUILD_PLACE. Existing skull slots include default-state wall skulls in either arm axis. Positive floor-only controls, wrong wall-skull species and Peaceful controls check structure preservation. This fixture exercises pattern recognition, not final wall-skull placement.",

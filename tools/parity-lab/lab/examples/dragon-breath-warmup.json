{
  "schema_version": 1,
  "id": "dragon-breath-warmup",
  "title": "Sitting dragons wait ten active ticks before emitting breath",
  "description": "Bounded ParitySmoke arena. Observe actual cloud absence through tick9 and creation at tick10, fresh clocks after phase reentry, NoAI pauses and same-phase NBT merges. Does not validate cloud position, damage, lifetime or complete sitting cycle.",

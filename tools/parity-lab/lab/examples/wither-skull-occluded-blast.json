      "observe": true,
      "expect_contains": "Test passed"
    },
    {
      "command": "summon minecraft:wither_skull 19.9 82.5 20.5 {Tags:[\"pp_shot\"],dangerous:0b,Motion:[0.4d,0.0d,0.0d]}"
    },
    {

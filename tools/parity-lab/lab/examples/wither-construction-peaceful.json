{
  "schema_version": 1,
  "category": "entities",
  "tags": [
    "entity",
    "wither",
    "construction"
  ],
  "setup": [
    "tick freeze",
    "gamemode creative @a",
    "op ParitySmoke",
    "difficulty easy",
    "gamerule mob_griefing false",
    "gamerule spawn_mobs false",
    "forceload add 0 0 31 31",
    "fill 0 79 0 31 79 31 minecraft:bedrock",
    "tp @a 15.5 81 19.5",
    "item replace entity @a weapon.mainhand with minecraft:wither_skeleton_skull"
  ],
  "cleanup": [
    "kill @e[type=!minecraft:player]",
    "fill 12 80 12 18 85 18 minecraft:air",
    "forceload remove all"
  ],
  "id": "wither-construction-peaceful",
  "title": "Wither construction preserves the structure on Peaceful",
  "description": "Isolated creative client placement regression. At each PARITY_BUILD_PLACE marker send one main-hand UseItemOn packet against the indicated soul-block top, then advance the specified ticks. Both axes alternate Peaceful and Easy; all seven structure blocks and boss presence are checked. Console-only execution cannot exercise the final-skull callback.",

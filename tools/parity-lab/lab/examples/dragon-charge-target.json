{
  "schema_version": 1,
  "id": "dragon-charge-target",
  "title": "Dragon retains its charge target and recovers before circling",
  "description": "Two isolated trials use a distant survival player to start a charge, move the player, and teleport the dragon to the original target. Teleports separate charge phase state from general flight physics.",
  "category": "entity",
  "tags": [
    "ender-dragon",
    "ai"
  ],
  "setup": [
    "tick freeze",
    "difficulty normal",
    "gamerule spawn_mobs false",
    "gamerule mob_griefing false",
    "forceload add -48 -48 47 47",
    "gamemode creative ParitySmoke",
    "tp ParitySmoke 30 100 0",
    "gamerule random_tick_speed 0"
  ],

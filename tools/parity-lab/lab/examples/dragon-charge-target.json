      "command": "gamemode creative ParitySmoke"
    },
    {
      "command": "kill @e[type=minecraft:ender_dragon]"
    },
    {
      "command": "tp ParitySmoke 30 100 0"
    },
    {
      "command": "effect give ParitySmoke minecraft:resistance infinite 4 true"
    },
    {
      "command": "gamemode survival ParitySmoke"
    },
    {
      "command": "summon minecraft:ender_dragon 0 100 0 {PersistenceRequired:1b,NoAI:1b,DragonPhase:6,Tags:[\"charging\"]}"
    },
    {
      "command": "data merge entity @e[type=minecraft:ender_dragon,tag=charging,limit=1] {NoAI:0b}",
      "wait_ticks": 100

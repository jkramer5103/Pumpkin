{
  "schema_version": 1,
  "id": "wither-ranged-retarget",
  "title": "Wither main-head attacks follow retaliation target switches",
  "category": "entities",
  "description": "Acquire a sheep, then take damage attributed to a cow on the opposite side. Both victims stay alive. Check the main target metadata changes to the cow and the first central skull flies toward it. Repeat both directions, with an undamaged control.",
  "tags": [
    "entity",
    "wither",
    "ai",
    "combat"
  ],
  "setup": [
    "tick freeze",
    "gamemode creative @a",
    "difficulty easy",
    "gamerule spawn_mobs false",
    "gamerule mob_griefing false",
    "forceload add 0 0 31 31",
    "fill 0 79 0 31 96 31 minecraft:bedrock",
    "fill 1 80 1 30 95 30 minecraft:air",
    "tp @a 8.5 91 8.5"
  ],
  "steps": [
    {
      "command": "say PARITY_RETARGET_CASE=1-left-right"
    },
    {
      "command": "kill @e[type=!minecraft:player]",
      "wait_ticks": 25
    },
    {
      "command": "summon minecraft:sheep 6 80 8.5 {Tags:[\"pp_old\"],NoAI:1b,NoGravity:1b,Silent:1b}"
    },
    {
      "command": "attribute @e[tag=pp_old,limit=1] minecraft:max_health base set 1000"
    },
    {
      "command": "attribute @e[tag=pp_old,limit=1] minecraft:knockback_resistance base set 1"
    },
    {
      "command": "attribute @e[tag=pp_old,limit=1] minecraft:explosion_knockback_resistance base set 1"
    },
    {
      "command": "data merge entity @e[tag=pp_old,limit=1] {Health:1000.0f}"
    },
    {
      "command": "summon minecraft:wither 8.5 80 8.5 {Tags:[\"pp_boss\"],NoGravity:1b,Health:100.0f,Silent:1b,Invul:0}"

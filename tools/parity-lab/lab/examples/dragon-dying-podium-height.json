{
  "schema_version": 1,
  "id": "dragon-dying-podium-height",
  "title": "Dying dragon uses the space above the motion-blocking podium",
  "description": "Two isolated trials check health after one dying-phase tick on either side of the ten-block arrival boundary, with a nonblocking podium decoration and NoAI controls.",
  "category": "entity",
  "tags": [
    "ender-dragon",
    "ai"
  ],
  "setup": [
    "tick freeze",
    "difficulty normal",
    "gamerule spawn_mobs false",
    "gamerule mob_griefing false",
    "forceload add -48 -48 47 47",
    "gamemode creative ParitySmoke",
    "tp ParitySmoke 40 100 40",
    "setblock 0 79 0 minecraft:bedrock"
  ],
  "steps": [

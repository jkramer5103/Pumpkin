{
  "schema_version": 1,
  "id": "wither-side-head-range-inside",
  "title": "Wither side-head acquisition range inside",
  "category": "entities",
  "description": "Pin the Wither every tick and sample skulls for 40 ticks with a stationary golem at offset (14.0, 0, 14.0).",
  "tags": [
    "entity",
    "wither",
    "combat",
    "range"
  ],
  "setup": [
    "difficulty easy",
    "gamerule mob_griefing false",
    "gamerule spawn_mobs false",
    "forceload add 0 0 31 31",
    "scoreboard objectives add pp_range dummy",
    "scoreboard players set #skulls pp_range 0",
    "fill 0 79 0 30 86 30 minecraft:air",
    "fill 0 79 0 30 79 30 minecraft:bedrock",
    "summon minecraft:iron_golem 17.5 80 17.5 {NoAI:1b,NoGravity:1b,Silent:1b,PersistenceRequired:1b}",
    "summon minecraft:wither 3.5 80 3.5 {NoAI:1b,NoGravity:1b,Silent:1b,PersistenceRequired:1b}"
  ],
  "steps": [
    {
      "command": "time query gametime",
      "wait_ticks": 1
    },
    {
      "command": "data merge entity @e[type=minecraft:wither,limit=1] {NoAI:0b}"
    },
    {
      "command": "tp @e[type=minecraft:wither] 3.5 80 3.5"
    },
    {
      "command": "data merge entity @e[type=minecraft:wither,limit=1] {Motion:[0.0d,0.0d,0.0d]}"
    },
    {
      "command": "time query gametime",
      "wait_ticks": 1
    },
    {
      "command": "execute if entity @e[type=minecraft:wither_skull] run scoreboard players add #skulls pp_range 1"
    },
    {
      "command": "kill @e[type=minecraft:wither_skull]"
    },

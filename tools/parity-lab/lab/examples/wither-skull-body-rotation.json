    },
    {
      "command": "damage @e[tag=pp_boss,limit=1] 1 minecraft:generic"
    },
    {
      "command": "data merge entity @e[tag=pp_boss,limit=1] {Motion:[0.3d,0.0d,0.0d]}",
      "wait_ticks": 1
    },
    {
      "command": "execute if entity @e[type=minecraft:wither_skull,x=13.7,y=82.2,z=15,distance=..0.001]",
      "observe": true,
      "expect_contains": "Test passed"

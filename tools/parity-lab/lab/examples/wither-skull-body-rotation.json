{
  "schema_version": 1,
  "id": "wither-skull-body-rotation",
  "title": "Wither retaliation skull origins use body rotation during a turn",
  "category": "entities",
  "description": "Prime six hurt attempts while frozen, then give the boss horizontal motion on its first AI tick. Sideways movement turns entity yaw before attacks; both skull origins must remain on the previous body X axis. Forward and stationary controls share the same expected origins. Packet capture additionally verifies exactly two skulls and their positions.",
  "tags": [
    "wither",
    "entity",
    "projectile",
    "regression"
  ],
  "setup": [
    "gamemode creative @a",
    "difficulty normal",
    "gamerule mob_griefing false",
    "gamerule spawn_mobs false",
    "forceload add 0 0 31 31",
    "fill 0 79 0 31 79 31 minecraft:bedrock",
    "fill 0 80 0 31 95 31 minecraft:air",
    "tp @a 16 90 16"
  ],
  "steps": [
    {
      "command": "say PARITY_HEAD_YAW_CASE=east"
    },
    {
      "command": "kill @e[type=!minecraft:player]",
      "wait_ticks": 25
    },
    {
      "command": "summon minecraft:wither 15.0 80.0 15.0 {Tags:[\"pp_boss\"],NoGravity:1b,Silent:1b,PersistenceRequired:1b,Rotation:[0.0f,0.0f]}"
    },
    {
      "command": "damage @e[tag=pp_boss,limit=1] 1 minecraft:generic"
    },
    {
      "command": "damage @e[tag=pp_boss,limit=1] 1 minecraft:generic"
    },
    {
      "command": "damage @e[tag=pp_boss,limit=1] 1 minecraft:generic"
    },
    {
      "command": "damage @e[tag=pp_boss,limit=1] 1 minecraft:generic"
    },
    {

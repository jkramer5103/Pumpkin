{
  "schema_version": 1,
  "id": "dragon-breath-natural-expiration",
  "title": "Dragon breath expires after200 active cloud ticks plus20 wait ticks",
  "description": "Two isolated trials pause dragon AI immediately after natural flame emission. Track its actual cloud position, check late damage before natural expiration and no damage afterwards. Phase remains5, so removal cannot come from phase-exit cleanup.",
  "category": "entity",
  "tags": [
    "ender-dragon",
    "ai",
    "area-effect-cloud"
  ],
  "setup": [
    "tick freeze",
    "difficulty normal",
    "gamerule spawn_mobs false",
    "gamerule mob_griefing false",
    "forceload add -48 -48 47 47",
    "gamemode creative ParitySmoke",
    "tp ParitySmoke 20.0 80.0 20.0"
  ],
  "steps": [
    {
      "command": "kill @e[type=minecraft:ender_dragon]"
    },
    {
      "command": "kill @e[type=minecraft:area_effect_cloud]"
    },
    {
      "command": "kill @e[type=minecraft:sheep]"
    },
    {
      "command": "kill @e[type=minecraft:marker,tag=expiry_center]"
    },
    {
      "command": "summon minecraft:ender_dragon 0.5 100.0 0.5 {Silent:1b,NoGravity:1b,PersistenceRequired:1b,UUID:[I;0,0,0,310],DragonPhase:5}",
      "wait_ticks": 10
    },
    {
      "command": "execute if entity @e[type=minecraft:area_effect_cloud]",
      "observe": true,
      "expect_contains": "Test passed. Count: 1"
    },
    {
      "command": "tag @e[type=minecraft:area_effect_cloud] add original_flame"
    },
    {
      "command": "execute at @e[type=minecraft:area_effect_cloud,tag=original_flame,limit=1] run summon minecraft:marker ~ ~ ~ {Tags:[\"expiry_center\"]}"
    },
    {
      "command": "data merge entity @e[type=minecraft:ender_dragon,limit=1] {NoAI:1b}"
    },
    {
      "command": "tp @e[type=minecraft:ender_dragon] 30.0 100.0 30.0"
    },
    {
      "command": "data get entity @e[type=minecraft:ender_dragon,limit=1] DragonPhase",
      "wait_ticks": 205
    },
    {
      "command": "execute if entity @e[type=minecraft:area_effect_cloud,tag=original_flame]",
      "observe": true,
      "expect_contains": "Test passed. Count: 1"
    },
    {
      "command": "execute at @e[type=minecraft:marker,tag=expiry_center,limit=1] run summon minecraft:sheep ~ ~ ~ {NoAI:1b,NoGravity:1b,Silent:1b,Tags:[\"before_expiry\"]}"
    },
    {
      "command": "data get entity @e[type=minecraft:sheep,tag=before_expiry,limit=1] Health",
      "wait_ticks": 5
    },
    {
      "command": "execute if entity @e[type=minecraft:sheep,tag=before_expiry,nbt={Health:5.0f}]",
      "observe": true,
      "expect_contains": "Test passed. Count: 1"

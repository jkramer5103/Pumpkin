{
  "schema_version": 1,
  "id": "wither-side-head-player-creative",
  "title": "Wither side-head player acquisition in creative",
  "category": "entities",
  "description": "A sole connected player tests the side-head living-entity search, with creative and spectator exclusions. Easy difficulty excludes idle skull fire.",
  "tags": [
    "entity",
    "wither",
    "ai",
    "player",
    "target"
  ],
  "setup": [
    "difficulty easy",
    "gamerule mob_griefing false",
    "gamerule spawn_mobs false",
    "forceload add 0 0 31 31",
    "fill 0 79 0 31 79 31 minecraft:bedrock",
    "gamemode creative @a",
    "tp @a 16.5 80 8.5",
    "effect give @a minecraft:resistance infinite 255 true",
    "gamemode creative @a",
    "summon minecraft:wither 8.5 80 8.5 {Tags:[\"pp_boss\"],NoGravity:1b,Silent:1b,PersistenceRequired:1b}"
  ],
  "steps": [

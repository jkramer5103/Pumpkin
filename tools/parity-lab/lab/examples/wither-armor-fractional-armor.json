{
  "schema_version": 1,
  "id": "wither-armor-fractional-armor",
  "title": "Wither armor absorption: fractional-armor",
  "category": "entities",
  "description": "Compare resulting health with vanilla using natural or effective armor attributes. Frozen NoAI boss isolates damage from regeneration.",
  "tags": [
    "entity",
    "wither",
    "combat"
  ],
  "setup": [
    "tick freeze",
    "gamemode creative @a",
    "difficulty easy",
    "gamerule mob_griefing false",
    "gamerule spawn_mobs false",
    "forceload add 0 0 31 31",
    "fill 0 79 0 31 79 31 minecraft:bedrock",
    "fill 6 80 6 14 86 10 minecraft:air",
    "tp @a 16.5 84 16.5",
    "summon minecraft:wither 8.5 80 8.5 {Tags:[\"pp_boss\"],NoAI:1b,NoGravity:1b,Silent:1b,PersistenceRequired:1b,Health:300.0f,Invul:0}",
    "attribute @e[tag=pp_boss,limit=1] minecraft:armor base set 4.9"
  ],
  "steps": [
    {
      "command": "execute if entity @e[tag=pp_boss,nbt={Health:300.0f,Invul:0}]",
      "observe": true,
      "expect_contains": "Test passed"
    },
    {
      "command": "damage @e[tag=pp_boss,limit=1] 4 minecraft:mob_attack"
    },
    {
      "command": "execute if entity @e[tag=pp_boss,nbt={Health:296.32f}]",
      "observe": true,
      "expect_contains": "Test passed"
    }
  ],
  "cleanup": [
    "kill @e[type=!minecraft:player]"
  ]
}

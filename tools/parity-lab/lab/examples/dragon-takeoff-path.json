      "command": "summon minecraft:ender_dragon 0 110 0 {PersistenceRequired:1b,DragonPhase:10,Tags:[\"takeoff\"]}",
      "wait_ticks": 1
    },
    {
      "command": "tp @e[type=minecraft:ender_dragon,tag=takeoff,limit=1] 0 110 0 0 0"
    },
    {
      "command": "data merge entity @e[type=minecraft:ender_dragon,tag=takeoff,limit=1] {Motion:[0.0d,0.0d,0.0d],DragonPhase:4,NoAI:0b}"
    },

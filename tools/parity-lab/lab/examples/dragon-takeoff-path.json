{
  "schema_version": 1,
  "id": "dragon-takeoff-path",
  "title": "Dragon takeoff selects a flight path node rather than the fixed podium point",
  "description": "Two trials observe the first takeoff tick below raised flight nodes, at several headings, including repeated phase entry and NoAI controls. Vertical displacement is independent of randomized node height.",
  "category": "entity",
  "tags": [
    "ender-dragon",
    "ai"
  ],
  "setup": [
    "tick freeze",
    "difficulty normal",
    "gamerule spawn_mobs false",
    "gamerule mob_griefing false",
    "forceload add -64 -64 63 63",
    "gamemode creative ParitySmoke",
    "tp ParitySmoke 0 120 0"
  ],
  "steps": [
    {
      "command": "say Wait for arena chunks",
      "wait_ticks": 40
    },
    {
      "command": "fill -64 160 -64 63 160 63 minecraft:bedrock",
      "observe": true,
      "expect_contains": "16384"
    },
    {
      "command": "execute if block 60 160 0 minecraft:bedrock",
      "observe": true,
      "expect_contains": "Test passed"
    },
    {

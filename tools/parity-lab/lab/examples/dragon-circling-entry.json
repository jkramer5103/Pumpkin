      "command": "data get entity @e[type=minecraft:ender_dragon,tag=orbit,limit=1] Pos"
    },
    {
      "command": "data get entity @e[type=minecraft:ender_dragon,tag=orbit,limit=1] Motion"
    },
    {
      "command": "data get entity @e[type=minecraft:ender_dragon,tag=orbit,limit=1] DragonPhase"
    },
    {

{
  "schema_version": 1,
  "id": "dragon-death-timer",
  "title": "Restored dragon corpses finish their remaining death ticks",
  "description": "Isolated arena with ParitySmoke. Uses UUID selection because corpses are excluded from alive-only selectors. Tests loaded and merged death progress plus the absent-field default.",
  "category": "entity",
  "tags": [
    "ender-dragon",
    "death",
    "nbt"
  ],
  "setup": [
    "tick freeze",
    "difficulty normal",
    "gamerule spawn_mobs false",
    "gamerule mob_griefing false",
    "gamerule mob_drops false",
    "forceload add -16 -16 31 31",
    "gamemode creative ParitySmoke",
    "tp ParitySmoke 20.0 80.0 20.0"
  ],
  "steps": [

      "observe": true,
      "expect_contains": "Test passed"
    },
    {
      "command": "data merge entity @e[type=minecraft:ender_dragon,tag=route,limit=1] {DragonPhase:10,Motion:[0.0d,0.0d,0.0d]}"
    },
    {
      "command": "tp @e[type=minecraft:ender_dragon,tag=route] -40 90 0 0 0"
    },
    {

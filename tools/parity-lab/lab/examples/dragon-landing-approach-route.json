      "wait_ticks": 1
    },
    {
      "command": "execute if entity @e[type=minecraft:ender_dragon,tag=route,nbt={DragonPhase:2}]",
      "observe": true,
      "expect_contains": "Test passed"
    },
    {
      "command": "execute as @e[type=minecraft:ender_dragon,tag=route,nbt={DragonPhase:2}] run tp @s -40 240 0 0 0",
      "wait_ticks": 1
    },
    {
      "command": "execute as @e[type=minecraft:ender_dragon,tag=route,nbt={DragonPhase:2}] run tp @s -40 240 0 0 0",
      "wait_ticks": 1
    },
    {
      "command": "execute as @e[type=minecraft:ender_dragon,tag=route,nbt={DragonPhase:2}] run tp @s -40 240 0 0 0",
      "wait_ticks": 1
    },
    {
      "command": "execute as @e[type=minecraft:ender_dragon,tag=route,nbt={DragonPhase:2}] run tp @s -40 240 0 0 0",
      "wait_ticks": 1
    },
    {
      "command": "execute as @e[type=minecraft:ender_dragon,tag=route,nbt={DragonPhase:2}] run tp @s -40 240 0 0 0",
      "wait_ticks": 1
    },
    {
      "command": "execute as @e[type=minecraft:ender_dragon,tag=route,nbt={DragonPhase:2}] run tp @s -40 240 0 0 0",
      "wait_ticks": 1
    },
    {
      "command": "execute as @e[type=minecraft:ender_dragon,tag=route,nbt={DragonPhase:2}] run tp @s -40 240 0 0 0",
      "wait_ticks": 1
    },
    {
      "command": "execute as @e[type=minecraft:ender_dragon,tag=route,nbt={DragonPhase:2}] run tp @s -40 240 0 0 0",
      "wait_ticks": 1
    },
    {
      "command": "execute if entity @e[type=minecraft:ender_dragon,tag=route,nbt={DragonPhase:3}]",
      "observe": true,
      "expect_contains": "Test passed"
    },
    {
      "command": "execute if entity @e[type=minecraft:ender_dragon,tag=noai,nbt={DragonPhase:2,NoAI:1b}]",
      "observe": true,
      "expect_contains": "Test passed"
    },
    {
      "command": "execute if entity @e[type=minecraft:ender_dragon,tag=hover,nbt={DragonPhase:10}]",
      "observe": true,
      "expect_contains": "Test passed"
    },
    {
      "command": "execute if entity @e[type=minecraft:ender_dragon]",
      "observe": true,
      "expect_contains": "Test passed. Count: 4"
    }
  ],
  "cleanup": [
    "kill @e[type=minecraft:ender_dragon]",
    "setblock 0 79 0 minecraft:air",
    "execute unless entity @e[type=minecraft:ender_dragon]"
  ]
}

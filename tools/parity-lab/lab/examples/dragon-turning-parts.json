{
  "schema_version": 1,
  "id": "dragon-turning-parts",
  "title": "Turning dragon head and neck block footprint",
  "description": "Two isolated trials check block interactions after one controlled turning tick; corrected, previous and distant footprints plus straight and NoAI controls.",
  "category": "entity",
  "tags": [
    "ender-dragon",
    "ai"
  ],
  "setup": [
    "tick freeze",
    "difficulty normal",
    "gamerule spawn_mobs false",
    "gamerule mob_griefing true",
    "forceload add -48 -48 47 47",
    "gamemode creative ParitySmoke",
    "tp ParitySmoke 40 100 40"
  ],
  "steps": [
    {
      "command": "say Wait for arena chunks",
      "wait_ticks": 5
    },
    {
      "command": "kill @e[type=minecraft:ender_dragon]"
    },
    {
      "command": "fill -10 98 -40 10 110 40 minecraft:air"
    },
    {
      "command": "say TRIAL_1_negative-new"
    },
    {
      "command": "summon minecraft:ender_dragon 0.0 100.0 0.0 {PersistenceRequired:1b,DragonPhase:10,Tags:[\"turn_parts\"]}",
      "wait_ticks": 1
    },
    {
      "command": "tp @e[type=minecraft:ender_dragon,tag=turn_parts,limit=1] 0.0 100.0 -30.0 0 0"
    },
    {
      "command": "data merge entity @e[type=minecraft:ender_dragon,tag=turn_parts,limit=1] {Motion:[0.0d,0.0d,0.0d],NoAI:0b}"
    },
    {
      "command": "setblock 2 100 -36 minecraft:stone"
    },

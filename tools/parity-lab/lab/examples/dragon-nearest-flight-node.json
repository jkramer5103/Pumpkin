      "command": "execute if block 0 160 -40 minecraft:bedrock",
      "observe": true,
      "expect_contains": "Test passed"
    },
    {
      "command": "kill @e[type=minecraft:ender_dragon]"
    },
    {
      "command": "say TRIAL_1_x50_yaw90_active"
    },
    {
      "command": "summon minecraft:ender_dragon 60 120 0 {PersistenceRequired:1b,DragonPhase:10,Tags:[\"node_probe\"]}",
      "wait_ticks": 1
    },
    {
      "command": "tp @e[type=minecraft:ender_dragon,tag=node_probe,limit=1] 50 120 0 90 0"
    },
    {
      "command": "data merge entity @e[type=minecraft:ender_dragon,tag=node_probe,limit=1] {Motion:[0.0d,0.0d,0.0d],DragonPhase:4,NoAI:0b}"
    },
    {
      "command": "data get entity @e[type=minecraft:ender_dragon,tag=node_probe,limit=1] Pos"
    },
    {
      "command": "data get entity @e[type=minecraft:ender_dragon,tag=node_probe,limit=1] Motion"
    },
    {
      "command": "data get entity @e[type=minecraft:ender_dragon,tag=node_probe,limit=1] DragonPhase"
    },
    {
      "command": "say first_takeoff_tick",
      "wait_ticks": 1
    },
    {
      "command": "data get entity @e[type=minecraft:ender_dragon,tag=node_probe,limit=1] Pos",
      "observe": true,
      "expect_contains": "120.00600000023842d"
    },
    {
      "command": "data get entity @e[type=minecraft:ender_dragon,tag=node_probe,limit=1] Motion"
    },
    {
      "command": "execute if entity @e[type=minecraft:ender_dragon,tag=node_probe,limit=1,nbt={DragonPhase:4}]",

{
  "schema_version": 1,
  "id": "dragon-nearest-flight-node",
  "title": "Dragon nearest flight nodes exclude the outer ring without crystals",
  "description": "Two isolated trials test first takeoff steering beside an elevated inner flight ring with no End fight. At yaw 90 the eligible start and target nodes coincide, so vanilla remains stationary.",
  "category": "entity",
  "tags": [
    "ender-dragon",
    "ai"
  ],
  "setup": [
    "tick freeze",
    "difficulty normal",
    "gamerule spawn_mobs false",
    "gamerule mob_griefing false",
    "forceload add -64 -64 79 63",
    "gamemode creative ParitySmoke",
    "tp ParitySmoke 0 120 0"
  ],
  "steps": [
    {
      "command": "say Wait for arena chunks",
      "wait_ticks": 40
    },
    {
      "command": "fill -42 160 -42 42 160 42 minecraft:bedrock",
      "observe": true,
      "expect_contains": "7225"
    },
    {
      "command": "execute if block 40 160 0 minecraft:bedrock",
      "observe": true,
      "expect_contains": "Test passed"
    },
    {
      "command": "execute if block 20 160 0 minecraft:bedrock",
      "observe": true,
      "expect_contains": "Test passed"
    },
    {
      "command": "execute if block -40 160 0 minecraft:bedrock",

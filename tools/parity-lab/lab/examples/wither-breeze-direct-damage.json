{
  "schema_version": 1,
  "id": "wither-breeze-direct-damage",
  "title": "Powered Wither breeze and player wind charge damage sources",
  "category": "entities",
  "description": "Isolate direct damage from wind-charge bursts using real source entities and /damage. Powered bosses accept breeze sources, reject player wind-charge sources, and retain spawn and attacker immunities. This does not simulate projectile flight or bursts.",
  "tags": [
    "entity",
    "wither",
    "combat"
  ],
  "setup": [
    "tick freeze",
    "gamemode creative @a",
    "difficulty easy",
    "gamerule mob_griefing false",
    "gamerule spawn_mobs false",
    "forceload add 0 0 31 31",
    "fill 0 79 0 31 79 31 minecraft:bedrock",
    "fill 0 80 0 31 96 31 minecraft:air",
    "tp @a 16.5 92 16.5",
    "summon minecraft:breeze_wind_charge 24.5 90 24.5 {Tags:[\"pp_breeze\"],NoGravity:1b}",
    "summon minecraft:wind_charge 26.5 90 24.5 {Tags:[\"pp_wind\"],NoGravity:1b}",
    "summon minecraft:sheep 28.5 90 24.5 {Tags:[\"pp_sheep\"],NoAI:1b,NoGravity:1b}",
    "summon minecraft:wither 24.5 90 28.5 {Tags:[\"pp_wither_owner\"],NoAI:1b,NoGravity:1b}",
    "summon minecraft:zombie 26.5 90 28.5 {Tags:[\"pp_friend_owner\"],NoAI:1b,NoGravity:1b}"
  ],
  "steps": [
    {
      "command": "summon minecraft:wither 5.5 80 5.5 {Tags:[\"pp_case_0\"],NoAI:1b,NoGravity:1b,Silent:1b,Health:149.0f,Invul:0}"
    },
    {
      "command": "execute if entity @e[tag=pp_case_0,limit=1,nbt={Health:149.0f,Invul:0}]",
      "observe": true,
      "expect_contains": "Test passed"
    },

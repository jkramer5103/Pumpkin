{
  "schema_version": 1,
  "id": "dragon-flight-path-crystal-restriction",
  "title": "Dragon flight paths avoid outer-ring detours without live crystals",
  "description": "Two trials of first takeoff from each end of an elevated middle-ring route, plus flat-route and NoAI controls. No fight/crystals; compare vertical steering rather than random horizontal magnitudes.",
  "category": "entity",
  "tags": [
    "ender-dragon",
    "ai"
  ],
  "setup": [
    "tick freeze",
    "difficulty normal",
    "gamerule spawn_mobs false",
    "gamerule mob_griefing false",
    "forceload add -64 -64 79 63",
    "gamemode creative ParitySmoke",
    "tp ParitySmoke 0 120 0"
  ],
  "steps": [
    {
      "command": "say Wait for arena chunks",
      "wait_ticks": 40
    },
    {
      "command": "kill @e[type=minecraft:ender_dragon]"
    },
    {
      "command": "say TRIAL_1_raised_east"
    },
    {
      "command": "setblock 28 180 28 minecraft:stone"
    },
    {
      "command": "setblock -29 180 28 minecraft:stone"
    },
    {
      "command": "setblock -40 180 0 minecraft:stone"
    },
    {
      "command": "setblock -29 180 -29 minecraft:stone"
    },
    {
      "command": "setblock 0 180 -40 minecraft:stone"
    },
    {

    },
    {
      "command": "setblock -20 180 0 minecraft:stone"
    },
    {
      "command": "setblock 0 180 -20 minecraft:stone"
    },
    {
      "command": "execute if block 28 180 28 minecraft:stone",
      "observe": true,
      "expect_contains": "Test passed"
    },
    {
      "command": "summon minecraft:ender_dragon 60 120 0 {PersistenceRequired:1b,DragonPhase:10,Tags:[\"path_crystals_probe\"]}",
      "wait_ticks": 1
    },
    {
      "command": "tp @e[type=minecraft:ender_dragon,tag=path_crystals_probe,limit=1] 40.0 120.0 0.0 180 0"
    },
    {
      "command": "data merge entity @e[type=minecraft:ender_dragon,tag=path_crystals_probe,limit=1] {Motion:[0.0d,0.0d,0.0d],DragonPhase:4,NoAI:0b}"
    },
    {

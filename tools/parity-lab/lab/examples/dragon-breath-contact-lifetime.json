{
  "schema_version": 1,
  "id": "dragon-breath-contact-lifetime",
  "title": "Sitting dragon breath survives victim contacts",
  "description": "Isolated ParitySmoke arena. Six sheep contact a real dragon-created cloud: each must take damage and the cloud must remain available for a seventh sheep. Pause the emitting dragon with NoAI and move it away after emission to isolate cloud lifetime. Initial radius, natural shrink, phase duration and whole-fight/visual behavior are outside this check.",
  "category": "entity",
  "tags": [
    "ender-dragon",
    "ai",
    "area-effect-cloud"
  ],
  "setup": [
    "tick freeze",
    "difficulty normal",
    "gamerule spawn_mobs false",
    "gamerule mob_griefing false",
    "forceload add -48 -48 47 47",
    "gamemode creative ParitySmoke",
    "tp ParitySmoke 20.0 80.0 20.0",
    "kill @e[type=minecraft:ender_dragon]",
    "kill @e[type=minecraft:area_effect_cloud]",
    "kill @e[type=minecraft:sheep]",
    "kill @e[type=minecraft:marker,tag=breath_center]"
  ],

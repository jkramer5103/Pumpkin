{
  "schema_version": 1,
  "id": "wither-retaliation-empty-break",
  "title": "Wither block-break event requires a changed block",
  "category": "entities",
  "description": "Damage a Wither in sealed bedrock. Pure fluid, air and immune blocks do not cause event1022; stone and seagrass do. A second hit after solids are gone must stay quiet.",
  "tags": [
    "entity",
    "wither",
    "sound"
  ],
  "setup": [
    "tick freeze",
    "gamemode creative @a",
    "difficulty easy",
    "gamerule spawn_mobs false",
    "gamerule mob_griefing true",
    "gamerule block_drops true",
    "tp @a 15.5 87 15.5"
  ],
  "steps": [
    {
      "command": "say PARITY_EMPTY_BREAK_CASE=water"
    },
    {
      "command": "kill @e[type=!minecraft:player]",
      "wait_ticks": 25
    },
    {
      "command": "fill 13 79 13 17 84 17 minecraft:bedrock"
    },
    {
      "command": "fill 15 80 15 15 83 15 minecraft:air"
    },
    {
      "command": "setblock 14 81 14 minecraft:water"
    },
    {
      "command": "summon minecraft:wither 15.5 80 15.5 {Tags:[\"pp_boss\"],NoGravity:1b,Silent:1b,Health:300.0f,Invul:0}"
    },
    {
      "command": "execute if block 14 81 14 minecraft:water",
      "observe": true,
      "expect_contains": "Test passed"
    },
    {
      "command": "say PARITY_EMPTY_BREAK_PULSE=1"
    },
    {
      "command": "damage @e[tag=pp_boss,limit=1] 1 minecraft:generic",
      "wait_ticks": 19
    },
    {
      "command": "execute if block 14 81 14 minecraft:water",

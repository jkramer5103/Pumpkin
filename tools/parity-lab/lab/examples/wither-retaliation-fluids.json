  "setup": [
    "tick freeze",
    "gamemode creative @a",
    "difficulty easy",
    "gamerule spawn_mobs false",
    "gamerule mob_griefing true",
    "gamerule block_drops true",
    "tp @a 15.5 87 15.5"
  ],
  "steps": [

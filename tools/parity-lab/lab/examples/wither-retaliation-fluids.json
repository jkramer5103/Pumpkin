      "command": "say PARITY_FLUID_CASE=water"
    },
    {
      "command": "kill @e[type=!minecraft:player]",
      "wait_ticks": 25
    },
    {
      "command": "fill 13 79 13 17 84 17 minecraft:bedrock"
    },
    {
      "command": "fill 15 80 15 15 83 15 minecraft:air"
    },
    {
      "command": "setblock 14 81 14 minecraft:water"
    },
    {
      "command": "setblock 16 81 16 minecraft:stone"
    },
    {
      "command": "summon minecraft:wither 15.5 80 15.5 {Tags:[\"pp_boss\"],NoGravity:1b,Silent:1b,Health:300.0f,Invul:0}"
    },
    {
      "command": "execute if block 14 81 14 minecraft:water",
      "observe": true,
      "expect_contains": "Test passed"
    },
    {
      "command": "damage @e[tag=pp_boss,limit=1] 1 minecraft:generic",

{
  "schema_version": 1,
  "id": "wither-retaliation-fluids",
  "title": "Wither retaliation preserves the fluid left by destroyed blocks",
  "category": "entities",
  "description": "A damaged Wither breaks a solid control on the twentieth AI tick while retaining water, lava and the source water in seagrass. Sealed bedrock cells prevent refilling or flow from masking fluid removal.",
  "tags": [
    "entity",
    "wither",
    "fluid"

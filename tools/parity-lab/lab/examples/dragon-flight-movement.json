{
  "schema_version": 1,
  "id": "dragon-flight-movement",
  "title": "Dragon flight moves before applying its own drag",
  "description": "Two trials isolate one and three hovering flight ticks, small and large initial motion, perched targetless behavior and NoAI controls. Position-distance assertions and recorded vectors detect movement before drag and prevent a second living travel step.",
  "category": "entity",
  "tags": [
    "ender-dragon",
    "ai"
  ],
  "setup": [
    "tick freeze",
    "difficulty normal",
    "gamerule spawn_mobs false",
    "gamerule mob_griefing false",
    "forceload add -48 -48 47 47",
    "gamemode creative ParitySmoke",
    "tp ParitySmoke 40 100 40"
  ],
  "steps": [

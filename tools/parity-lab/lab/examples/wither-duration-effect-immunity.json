{
  "schema_version": 1,
  "id": "wither-duration-effect-immunity",
  "title": "Withers reject effects from tipped and spectral arrows",
  "category": "entities",
  "description": "Land real arrow hits on full-health Withers and sheep. Withers take the impact but reject duration effects; sheep receive the same payload. Resistance V must not shield a Wither from a later magic hit. NoAI holds the bosses still and prevents regeneration.",
  "tags": [
    "entity",
    "wither",
    "combat"
  ],
  "setup": [
    "tick freeze",
    "gamemode creative @a",
    "difficulty easy",
    "gamerule mob_griefing false",
    "gamerule spawn_mobs false",
    "forceload add 0 0 31 31",
    "fill 0 79 0 31 79 31 minecraft:bedrock",
    "fill 0 80 0 31 96 31 minecraft:air",
    "tp @a 28.5 92 28.5"
  ],
  "steps": [
    {
      "command": "summon minecraft:wither 5.5 80 10.5 {Tags:[\"pp_case_0\"],NoAI:1b,NoGravity:1b,Silent:1b,Health:300.0f}"
    },
    {
      "command": "execute if entity @e[tag=pp_case_0,nbt={Health:300.0f}]",
      "observe": true,
      "expect_contains": "Test passed"
    },
    {
      "command": "summon minecraft:arrow 5.5 81 7.5 {Tags:[\"pp_shot\"],Motion:[0.0d,0.0d,0.8d],NoGravity:1b,damage:1.0d,item:{id:\"minecraft:tipped_arrow\",count:1,components:{\"minecraft:potion_contents\":{custom_effects:[{id:\"minecraft:resistance\",duration:3200,amplifier:4}]}}}}",
      "wait_ticks": 8
    },
    {
      "command": "execute unless entity @e[tag=pp_case_0,nbt={Health:300.0f}]",
      "observe": true,
      "expect_contains": "Test passed"
    },
    {
      "command": "data get entity @e[tag=pp_case_0,limit=1] Health"
    },
    {
      "command": "execute unless entity @e[tag=pp_case_0,nbt={active_effects:[{id:\"minecraft:resistance\"}]}]",
      "observe": true,
      "expect_contains": "Test passed"

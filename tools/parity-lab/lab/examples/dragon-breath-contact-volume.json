{
  "schema_version": 1,
  "id": "dragon-breath-contact-volume",
  "title": "Dragon breath uses a thin horizontal contact volume",
  "description": "Two actual emitted-flame trials compare vertical misses, overlapping victims and horizontal radius. The NoAI emitter is moved away after emission; all test entities remain in the seeded chunk.",
  "category": "entity",
  "tags": [
    "ender-dragon",
    "area-effect-cloud",
    "damage"
  ],
  "setup": [
    "tick freeze",
    "difficulty normal",
    "gamerule spawn_mobs false",
    "gamerule mob_griefing false",
    "forceload add 0 0 15 15",
    "gamemode creative ParitySmoke",
    "tp ParitySmoke 20 100 20",
    "kill @e[type=minecraft:ender_dragon]",
    "kill @e[type=minecraft:area_effect_cloud]",
    "kill @e[type=minecraft:sheep]",
    "kill @e[type=minecraft:marker,tag=volume_center]"

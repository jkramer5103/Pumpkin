  "setup": [
    "tick freeze",
    "difficulty easy",
    "gamemode creative @a",
    "gamerule spawn_mobs false",
    "gamerule mob_griefing true",
    "gamerule block_drops true",
    "forceload add 0 0 31 31",
    "fill 0 79 0 31 79 31 minecraft:bedrock",
    "fill 6 80 6 12 86 12 minecraft:air",
    "tp @a 16.5 84 16.5",
    "summon minecraft:wither 8.5 80 8.5 {Tags:[\"pp_boss\"],NoGravity:1b,Silent:1b,PersistenceRequired:1b,Invul:0}",
    "setblock 8 80 8 minecraft:dirt",
    "setblock 9 80 8 minecraft:bedrock",
    "setblock 11 80 8 minecraft:dirt"
  ],

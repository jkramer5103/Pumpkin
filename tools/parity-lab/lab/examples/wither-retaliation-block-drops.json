{
  "schema_version": 1,
  "id": "wither-retaliation-block-drops",
  "title": "Wither retaliation destroys blocks with loot",
  "category": "entities",
  "description": "A damaged active Wither breaks nearby dirt after twenty AI ticks and drops its item, subject to mob griefing and block drops. Bedrock and out-of-range blocks survive.",
  "tags": [
    "entity",
    "wither",
    "loot"

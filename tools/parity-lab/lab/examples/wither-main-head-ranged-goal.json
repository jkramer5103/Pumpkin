    "difficulty easy",
    "gamemode creative @a",
    "gamerule spawn_mobs false",
    "gamerule mob_griefing false",
    "forceload add 0 0 47 31",
    "fill 0 79 0 47 79 31 minecraft:bedrock",
    "tp @a 16.5 84 16.5",
    "fill 15 80 3 15 96 14 minecraft:air",

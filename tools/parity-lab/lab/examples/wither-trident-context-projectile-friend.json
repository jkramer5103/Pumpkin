{
  "schema_version": 1,
  "id": "wither-trident-context-projectile-friend",
  "title": "Wither trident direct source and causing entity control",
  "category": "entities",
  "description": "Isolate direct projectile immunity from trident damage type and attacker identity.",
  "tags": [
    "entity",
    "wither",
    "combat"
  ],
  "setup": [
    "tick freeze",
    "gamemode creative @a",
    "difficulty easy",
    "gamerule mob_griefing false",
    "gamerule spawn_mobs false",
    "forceload add 0 0 31 31",
    "fill 0 79 0 31 79 31 minecraft:bedrock",
    "tp @a 16.5 84 16.5",
    "summon minecraft:wither 8.5 80 8.5 {Tags:[\"pp_boss\"],NoAI:1b,NoGravity:1b,Silent:1b,Health:300.0f,Invul:0}",
    "summon minecraft:trident 20.5 80 8.5 {Tags:[\"pp_direct\"],NoAI:1b,NoGravity:1b,Silent:1b}",
    "summon minecraft:zombie 24.5 80 8.5 {Tags:[\"pp_cause\"],NoAI:1b,NoGravity:1b,Silent:1b}"
  ],
  "steps": [
    {
      "command": "execute if entity @e[tag=pp_boss,nbt={Health:300.0f}]",
      "observe": true,
      "expect_contains": "Test passed"
    },
    {
      "command": "damage @e[tag=pp_boss,limit=1] 4 minecraft:trident by @e[tag=pp_direct,limit=1] from @e[tag=pp_cause,limit=1]"
    },
    {
      "command": "execute if entity @e[tag=pp_boss,nbt={Health:300f}]",
      "observe": true,
      "expect_contains": "Test passed"
    }
  ],
  "cleanup": [
    "kill @e[type=!minecraft:player]"
  ]
}

{
  "schema_version": 1,
  "id": "wither-spawn-sound",
  "title": "Wither spawn completion sound dispatch",
  "category": "entities",
  "description": "Complete spawn invulnerability near and outside tracking range, with NoAI, charging and local-sound controls. A protocol client must additionally inspect level event 1023 flag, count and observer-relative position.",
  "tags": [
    "wither",
    "boss",
    "sound",
    "packet"
  ],
  "setup": [
    "gamemode creative @a",
    "difficulty easy",
    "gamerule mob_griefing false",
    "gamerule spawn_mobs false",
    "forceload add 0 0 31 31"
  ],
  "steps": [
    {
      "command": "say PARITY_SOUND_CASE=near"
    },
    {
      "command": "kill @e[type=!minecraft:player]",
      "wait_ticks": 25
    },
    {
      "command": "gamerule global_sound_events true"
    },
    {
      "command": "tp @a 15.0 84.0 15.0",
      "wait_ticks": 2
    },
    {
      "command": "execute if entity @a[nbt={Pos:[15.0d,84.0d,15.0d]}]",
      "observe": true,
      "expect_contains": "Test passed"
    },
    {
      "command": "fill 20 79 20 28 79 28 minecraft:bedrock"
    },
    {
      "command": "summon minecraft:wither 24.0 80.0 24.0 {Tags:[\"pp_boss\"],NoGravity:1b,Health:300.0f,Invul:1,Silent:0b,NoAI:0b}",
      "wait_ticks": 1
    },
    {
      "command": "execute if entity @e[tag=pp_boss,nbt={Invul:0}]",
      "observe": true,
      "expect_contains": "Test passed"
    },
    {

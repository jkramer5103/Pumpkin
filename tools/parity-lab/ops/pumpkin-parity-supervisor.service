[Unit]
Description=Pumpkin Parity Lab two-subscription campaign
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=root
Environment=GH_CONFIG_DIR=/root/.config/gh
Environment=PATH=/root/.cargo/bin:/root/.local/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin
WorkingDirectory=/root/pumpkin-parity-lab
ExecStart=/usr/bin/python3 /root/pumpkin-parity-lab/ops/supervisor.py
Restart=on-failure
RestartSec=15
MemoryMax=6G
CPUQuota=300%
KillMode=control-group
TimeoutStopSec=30
UMask=0077

[Install]
WantedBy=multi-user.target
